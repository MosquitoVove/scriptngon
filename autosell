local function parseKeepRows()
    local out = {}
    for line in (keepBox.Text .. "\n"):gmatch("(.-)\n") do
        local name, list = line:match("^%s*(.-)%s*|%s*(.-)%s*$")
        if name and name ~= "" then
            local rs = {}
            for rarity in list:gmatch("[^,]+") do rs[normalize(rarity)] = true end
            table.insert(out, {name = name, rarities = rs})
        end
    end
    return out
end
local function parsePotentialRows()
    local out = {}
    for line in (potentialBox.Text .. "\n"):gmatch("(.-)\n") do
        local name, kind, threshold = line:match("^%s*(.-)%s*|%s*(.-)%s*|%s*(.-)%s*$")
        kind = normalize(kind)
        if name and name ~= "" and (kind == "physical" or kind == "spell") and tonumber(threshold) and tonumber(threshold) >= 0 then
            table.insert(out, {name = name, type = kind, power = tostring(threshold)})
        end
    end
    return out
end
