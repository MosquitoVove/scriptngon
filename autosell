-- Restore the enabled state after teleport/re-execution through persisted config.
-- A new run with no config is OFF. Count a dungeon entry only when place changes.
local currentPlace = game.PlaceId
if lastPlaceId and lastPlaceId ~= currentPlace and currentPlace ~= LOBBY_PLACE_ID then
    cfg.dungeonCount = cfg.dungeonCount + 1
    saveConfig()
end
cfg.lastPlaceId = currentPlace
saveConfig()
local startedAt = os.clock()
local nextMapCount = cfg.dungeonCount + math.max(1, math.floor(cfg.scheduleValue))
local wasDungeon = currentPlace ~= LOBBY_PLACE_ID
local lastObservedPlace = currentPlace

task.spawn(function()
    while gui.Parent do
        task.wait(1)
        if not gui.Parent then break end
        local place = game.PlaceId
        if place ~= lastObservedPlace then
            if place ~= LOBBY_PLACE_ID then
                cfg.dungeonCount = cfg.dungeonCount + 1
                if cfg.scheduleMode == "maps" and cfg.dungeonCount >= nextMapCount then
                    nextMapCount = cfg.dungeonCount + math.max(1, math.floor(cfg.scheduleValue))
                    if cfg.auto then task.spawn(function() preview(true) end) end
                end
            end
            lastObservedPlace = place; cfg.lastPlaceId = place; saveConfig()
        end
        if cfg.auto and cfg.scheduleMode == "seconds" and not busy and os.clock() - math.max(startedAt, lastSellAt) >= cfg.scheduleValue then
            startedAt = os.clock()
            task.spawn(function() preview(true) end)
        end
    end
end)

-- Save on exit/teleport; ON/OFF and schedule persist for the next execution.
player.OnTeleport:Connect(function()
    cfg.lastPlaceId = game.PlaceId
    saveConfig()
end)
game:BindToClose(function() cfg.lastPlaceId = game.PlaceId; saveConfig() end)

status.Text = cfg.auto and "Auto Sell restored ON. Preview first; selling follows saved schedule." or "Ready. Auto Sell is OFF; preview is safe."
