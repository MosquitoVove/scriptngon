local function safeDecode(s)
    if type(s) ~= "string" then return {} end
    local ok, value = pcall(function() return HttpService:JSONDecode(s) end)
    return ok and type(value) == "table" and value or {}
end
local function loadConfig()
    if type(readfile) == "function" then
        local ok, data = pcall(function() return readfile(CONFIG_FILE) end)
        if ok then return safeDecode(data) end
    end
    return safeDecode(player:GetAttribute(CONFIG_KEY))
end
