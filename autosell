local busy = false
local lastSellAt = 0
local lastMapTrigger = cfg.dungeonCount
local lastPlaceId = cfg.lastPlaceId
local function preview(doSell)
    if busy then return false, "A sale/preview is already running." end
    local ok, message = syncFromUI()
    if not ok then status.Text = message; return false, message end
    busy = true
    status.Text = "Reading inventory…"
    local success, plan = pcall(scanInventory)
    if not success then busy = false; status.Text = "Inventory error: " .. tostring(plan); return false, tostring(plan) end
    local lines = {"WOULD SELL: " .. #plan.sell, "WOULD KEEP: " .. #plan.kept}
    for i = 1, math.min(#plan.sell, 24) do table.insert(lines, "SELL  " .. plan.sell[i]) end
    if #plan.sell > 24 then table.insert(lines, "… and " .. (#plan.sell - 24) .. " more") end
    for i = 1, math.min(#plan.kept, 16) do table.insert(lines, "KEEP  " .. plan.kept[i]) end
    if #plan.kept > 16 then table.insert(lines, "… and " .. (#plan.kept - 16) .. " more") end
    results.Text = table.concat(lines, "\n")
    if not doSell or plan.count == 0 then
        status.Text = doSell and "Nothing matched the sell rules." or "Preview complete — nothing was sold."
        busy = false
        return true, plan
    end
    if cfg.auto ~= true and doSell then
        status.Text = "Auto Sell is OFF. Turn it ON to allow selling."
        busy = false
        return false, "Auto Sell is OFF"
    end
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    local sellRemote = remotes and remotes:FindFirstChild("sellItemEvent")
    local reload = remotes and remotes:FindFirstChild("reloadInvy")
    if not sellRemote or not sellRemote:IsA("RemoteEvent") or not reload then
        busy = false; status.Text = "Sell remote or inventory remote missing."; return false, "remote missing"
    end
    -- IMPORTANT: one batch FireServer call for all filtered items, including in dungeons.
    local sent, sendErr = pcall(function() sellRemote:FireServer(plan.payload) end)
    if not sent then busy = false; status.Text = "Batch send failed: " .. tostring(sendErr); return false, tostring(sendErr) end
    task.wait(2)
    local verifyOk, after = pcall(function() return reload:InvokeServer() end)
    if not verifyOk or type(after) ~= "table" then
        status.Text = ("Sent one batch for %d items; verification inventory unavailable."):format(plan.count)
        busy = false; return true, "verification unavailable"
    end
    local ids = payloadIds(plan.payload)
    local remaining = inventoryStillContains(after, ids)
    local gone = math.max(0, plan.count - remaining)
    status.Text = ("Batch requested %d; verified missing from inventory: %d. Check the game result if this differs."):format(plan.count, gone)
    lastSellAt = os.clock()
    busy = false
    saveConfig()
    return true, plan
end

local function setAuto(value)
