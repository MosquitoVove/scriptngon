        if not ok then return end
        local confirm = make("Frame", {Size = UDim2.fromOffset(360, 170), Position = UDim2.new(.5, -180, .5, -85), BackgroundColor3 = bg, ZIndex = 20}, gui)
        make("UICorner", {CornerRadius = UDim.new(0, 10)}, confirm)
        make("TextLabel", {Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, 76), BackgroundTransparency = 1, Text = "Preview ready. This enables automatic selling on the selected schedule. The batch payload in dungeons is not confirmed by the source files. Enable Auto Sell?", TextWrapped = true, TextColor3 = ink, TextSize = 12, Font = Enum.Font.Gotham, ZIndex = 21}, confirm)
        local yes = make("TextButton", {Position = UDim2.fromOffset(14, 112), Size = UDim2.fromOffset(150, 34), BackgroundColor3 = green, Text = "Confirm ON", TextColor3 = ink, TextSize = 12, ZIndex = 21}, confirm)
        local no = make("TextButton", {Position = UDim2.fromOffset(190, 112), Size = UDim2.fromOffset(150, 34), BackgroundColor3 = card, Text = "Cancel", TextColor3 = ink, TextSize = 12, ZIndex = 21}, confirm)
        yes.MouseButton1Click:Once(function()
            cfg.auto = true; saveConfig(); autoButton.Text = "Auto Sell: ON"; autoButton.BackgroundColor3 = green; status.Text = "Auto Sell ON. Config saved."; confirm:Destroy()
        end)
        no.MouseButton1Click:Once(function() confirm:Destroy() end)
        return
    end
    cfg.auto = value == true
    autoButton.Text = cfg.auto and "Auto Sell: ON" or "Auto Sell: OFF"
    autoButton.BackgroundColor3 = cfg.auto and green or card
    saveConfig()
    status.Text = "Auto Sell " .. (cfg.auto and "ON" or "OFF") .. ". Configuration saved."
end

