    auto = saved.auto == true,
    scheduleMode = saved.scheduleMode == "maps" and "maps" or "seconds",
    scheduleValue = math.clamp(tonumber(saved.scheduleValue) or 60, 1, 99999),
    keepLevel = math.max(0, math.floor(tonumber(saved.keepLevel) or 0)),
    abilityAmount = math.max(0, math.floor(tonumber(saved.abilityAmount) or 0)),
    abilityNamesText = type(saved.abilityNamesText) == "string" and saved.abilityNamesText or "",
    selected = type(saved.selected) == "table" and saved.selected or {},
    keepRows = type(saved.keepRows) == "table" and saved.keepRows or {},
    potentialRows = type(saved.potentialRows) == "table" and saved.potentialRows or {},
    lastPlaceId = tonumber(saved.lastPlaceId),
    dungeonCount = math.max(0, math.floor(tonumber(saved.dungeonCount) or 0)),
}
