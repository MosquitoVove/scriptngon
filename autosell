local function saveConfig()
    local ok, encoded = pcall(function() return HttpService:JSONEncode(cfg) end)
    if not ok then return false end
    pcall(function() player:SetAttribute(CONFIG_KEY, encoded) end)
    if type(writefile) == "function" then
        if type(isfolder) == "function" and type(makefolder) == "function" then
            pcall(function() if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end end)
        end
        pcall(function() writefile(CONFIG_FILE, encoded) end)
    end
    return true
end

local function normalize(value)
    local s = tostring(value or ""):lower()
    return (s:match("^%s*(.-)%s*$") or "")
end
local function splitNames(s)
    local out = {}
    for line in (tostring(s or "") .. "\n"):gmatch("(.-)\n") do
        local n = normalize(line)
        if n ~= "" then out[n] = true end
    end
    return out
end
local function checkAbilityEquipped(item)
    if type(item.equipped) == "table" then
        for _, value in pairs(item.equipped) do if value == true then return true end end
        return false
    end
    return item.equipped == true
end
local STAT_FIELDS = {
    physical = {"physicalPower", "physicalDamage"},
    spell = {"spellPower", "SpellPower", "spellDamage", "SpellDamage"},
    total = {"maxUpgrades", "MaxUpgrades", "maximumUpgrades", "MaximumUpgrades", "totalUpgrades", "TotalUpgrades"},
    used = {"currentUpgrade", "CurrentUpgrade", "currentUpgrades", "CurrentUpgrades", "upgradesUsed", "UpgradesUsed"},
}
local function readStat(item, fields)
    for _, field in ipairs(fields) do
        local raw = item[field]
        if raw ~= nil then
            local n = tonumber(raw)
            if n and n == n and n >= 0 and n < math.huge then return n end
            return nil
        end
    end
    return nil
end
local function armorPotential(item, powerType)
    local power = readStat(item, STAT_FIELDS[powerType])
    local total = readStat(item, STAT_FIELDS.total)
    local used = readStat(item, STAT_FIELDS.used)
    if power == nil or total == nil or used == nil or used > total then return nil end
    return power + (total - used) * POWER_PER_UPGRADE
end
local function nameMatches(item, target)
    local n = normalize(target)
    for _, field in ipairs({"name", "abilityName", "itemName", "gearName"}) do
        if type(item[field]) == "string" and normalize(item[field]) == n and n ~= "" then return true end
    end
    return false
end
local function keepByNameRarity(item)
    if type(item) ~= "table" then return false end
    local name, rarity = normalize(item.name), normalize(item.rarity)
    if name == "" or rarity == "" then return false end
    for _, row in ipairs(cfg.keepRows) do
        if normalize(row.name) == name and type(row.rarities) == "table" and row.rarities[rarity] == true then return true end
    end
    return false
end
local function potentialRule(item)
    if type(item) ~= "table" then return false, true end
    for _, row in ipairs(cfg.potentialRows) do
        local n, threshold = normalize(row.name), tonumber(row.power)
        if n ~= "" and threshold and threshold >= 0 and (row.type == "physical" or row.type == "spell") and nameMatches(item, n) then
            local value = armorPotential(item, row.type)
            if value == nil then return true, true end -- Unknown data means safe keep.
            if value >= threshold then return true, false end
        end
    end
    return false, false
end

local function scanInventory()
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    local reload = remotes and remotes:FindFirstChild("reloadInvy")
    if not reload or not reload:IsA("RemoteFunction") then error("reloadInvy RemoteFunction was not found") end
    local inventory = reload:InvokeServer()
    if type(inventory) ~= "table" then error("Inventory response is not a table") end

    local payload = {weapon = {}, helmet = {}, chest = {}, ability = {}}
    local kept, sell = {}, {}
    local abilityNames = splitNames(cfg.abilityNamesText)
    local abilityCounts = {}
    local function add(list, text, reason)
        table.insert(list, text .. (reason and (" — " .. reason) or ""))
    end
    local function processGear(invKey, payloadKey, prefix)
        local items = inventory[invKey]
        if items ~= nil and type(items) ~= "table" then error("Inventory category invalid: " .. invKey) end
        for key, item in pairs(items or {}) do
            local text = type(item) == "table" and (tostring(item.name or key) .. " · " .. tostring(item.rarity or "?") .. " · Lv " .. tostring(item.levelReq or "?")) or tostring(key)
            local reason
            if type(item) ~= "table" then reason = "unrecognized item data"
            elseif normalize(item.name) == "" then reason = "missing item name"
            elseif item.equipped == true then reason = "equipped"
            elseif item.equipped ~= false then reason = "unknown equipped status"
            elseif keepByNameRarity(item) then reason = "keep by name + rarity"
            else
                local pkeep, unknown = potentialRule(item)
                if pkeep then reason = unknown and "potential data unavailable (safe keep)" or "armor potential" end
            end
            if not reason and (type(item.rarity) ~= "string" or not cfg.selected[normalize(item.rarity)]) then reason = "rarity not selected" end
            if not reason and cfg.keepLevel > 0 then
                local level = tonumber(item.levelReq)
                if level == nil then reason = "unknown level"
                elseif level >= cfg.keepLevel then reason = "level " .. cfg.keepLevel .. "+" end
            end
            local id = type(key) == "string" and tonumber(key:match("^" .. prefix .. "_(%d+)$")) or nil
            if not reason and not id then reason = "unknown item ID" end
            if reason then add(kept, text, reason)
            else table.insert(payload[payloadKey], id); add(sell, text) end
        end
    end
    processGear("weapons", "weapon", "weapon")
    processGear("helmets", "helmet", "helmet")
    processGear("chests", "chest", "chest")

    local abilities = {}
    for key, item in pairs(inventory.abilities or {}) do
        if type(item) == "table" then table.insert(abilities, {key = key, item = item}) end
    end
    table.sort(abilities, function(a, b) return tostring(a.key) < tostring(b.key) end)
    for _, entry in ipairs(abilities) do
        local key, item = entry.key, entry.item
        local text = tostring(item.name or key) .. " · " .. tostring(item.rarity or "?") .. " · Lv " .. tostring(item.levelReq or "?")
        local reason, forceSellReason
        if checkAbilityEquipped(item) then reason = "equipped"
        elseif keepByNameRarity(item) then reason = "keep by name + rarity"
        else
            local pkeep, unknown = potentialRule(item)
            if pkeep then reason = unknown and "potential data unavailable (safe keep)" or "armor potential"
            elseif cfg.abilityAmount > 0 then
                local n = normalize(item.name)
                if n == "" then forceSellReason = "missing ability name"
                elseif next(abilityNames) ~= nil and not abilityNames[n] then forceSellReason = "ability not listed"
                else
                    local used = abilityCounts[n] or 0
                    if used < cfg.abilityAmount then abilityCounts[n] = used + 1; reason = "keep ability quota"
                    else forceSellReason = "ability quota exceeded" end
                end
            end
        end
        local id = type(key) == "string" and tonumber(key:match("^ability_(%d+)$")) or nil
        if reason then add(kept, text, reason)
        elseif forceSellReason then
            if id then table.insert(payload.ability, id); add(sell, text, forceSellReason)
            else add(kept, text, "unknown item ID") end
        elseif not id then add(kept, text, "unknown item ID")
        elseif type(item.rarity) ~= "string" then add(kept, text, "unknown rarity")
        elseif cfg.selected[normalize(item.rarity)] then table.insert(payload.ability, id); add(sell, text)
        else add(kept, text, "rarity not selected") end
    end
    local count = #payload.weapon + #payload.helmet + #payload.chest + #payload.ability
    return {payload = payload, kept = kept, sell = sell, count = count, inventory = inventory}
end

local function payloadIds(payload)
    local ids = {}
    for key, list in pairs(payload) do for _, id in ipairs(list) do ids[key .. "_" .. tostring(id)] = true end end
    return ids
end
local function inventoryStillContains(inv, ids)
    local found = 0
    for _, pair in ipairs({{"weapons", "weapon"}, {"helmets", "helmet"}, {"chests", "chest"}, {"abilities", "ability"}}) do
        for key, item in pairs(inv[pair[1]] or {}) do
            local id = type(key) == "string" and (pair[2] .. "_" .. tostring(key:match("^" .. pair[2] .. "_(%d+)$"))) or ""
            if ids[id] then found = found + 1 end
            if type(item) == "table" and type(item.UniqueItemID) == "string" and ids[item.UniqueItemID] then found = found + 1 end
        end
    end
    return found
end

